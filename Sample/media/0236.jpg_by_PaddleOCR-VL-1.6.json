[{"prunedResult":{"model_settings":{"use_doc_preprocessor":false,"use_layout_detection":true,"use_chart_recognition":false,"use_seal_recognition":true,"use_ocr_for_image_block":false,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"header","block_content":"DEAD OR ALIVE","block_bbox":[1666,78,2228,145],"block_id":0,"group_id":0,"block_polygon_points":[[1666.0,78.0],[2228.0,78.0],[2228.0,145.0],[1666.0,145.0]]},{"block_label":"header_image","block_content":"","block_bbox":[2229,69,2317,181],"block_id":1,"group_id":1,"block_polygon_points":[[2229.0,69.0],[2317.0,69.0],[2317.0,181.0],[2229.0,181.0]]},{"block_label":"doc_title","block_content":"# 霞 KASUMI","block_bbox":[826,251,1224,666],"block_id":2,"block_order":1,"group_id":2,"block_polygon_points":[[826.0,251.0],[1224.0,251.0],[1224.0,666.0],[826.0,666.0]]},{"block_label":"doc_title","block_content":"# DEAD OR ALIVE","block_bbox":[1565,203,2365,311],"block_id":3,"block_order":2,"group_id":3,"block_polygon_points":[[1565.0,203.0],[2365.0,203.0],[2365.0,311.0],[1565.0,311.0]]},{"block_label":"vertical_text","block_content":"ストーリー","block_bbox":[695,281,758,657],"block_id":4,"block_order":3,"group_id":4,"block_polygon_points":[[695.0,281.0],[758.0,281.0],[758.0,657.0],[695.0,657.0]]},{"block_label":"doc_title","block_content":"# キャラクター紹介 第1回","block_bbox":[2256,275,2372,1395],"block_id":5,"block_order":4,"group_id":5,"block_polygon_points":[[2255.999755859375,337.0],[2370.999755859375,337.0],[2370.999755859375,1393.999755859375],[2255.999755859375,1393.999755859375]]},{"block_label":"vertical_text","block_content":"自ら霧に溶け、幻となって敵を討つ忍の術、霧幻天神流幼少のころから兄・疾風と共に、父でもある第十七代頭首・紫電の厳しい指南を受けてきた霞は、その体術では並ぶものがいないほどの使い手になっていた。","block_bbox":[329,279,675,678],"block_id":6,"block_order":5,"group_id":6,"block_polygon_points":[[329.0,279.0],[675.0,279.0],[675.0,678.0],[329.0,678.0]]},{"block_label":"vertical_text","block_content":"れで倒れている疾風が見つかった。ひどく傷つけられ、体の自由を奪われてしまっていた。","block_bbox":[1256,730,1427,1123],"block_id":7,"block_order":6,"group_id":7,"block_polygon_points":[[1256.0,730.0],[1427.0,730.0],[1427.0,1123.0],[1256.0,1123.0]]},{"block_label":"vertical_text","block_content":"紫電が疾風に頭首の座を受け継がせようとした、まさにその日、異変は起きた。修行に出たまま、疾風が帰ってこないのだ。1力月後、血まみ","block_bbox":[106,279,321,668],"block_id":8,"block_order":7,"group_id":8,"block_polygon_points":[[106.0,279.0],[321.0,279.0],[321.0,668.0],[106.0,668.0]]},{"block_label":"vertical_text","block_content":"「霞、おまえがワシの後を継ぐのじゃ」","block_bbox":[1162,731,1250,1121],"block_id":9,"block_order":8,"group_id":9,"block_polygon_points":[[1162.0,731.0],[1250.0,731.0],[1250.0,1121.0],[1162.0,1121.0]]},{"block_label":"vertical_text","block_content":"正式に頭首となる18歳を間近に迎えた夜、霞は兄の眠る部屋から、物音が漏れていることに気がついた。そこには黒装束を身にまとった忍の者が、今まさに疾風の首を斬ろうとしていた。","block_bbox":[814,725,1116,1122],"block_id":10,"block_order":9,"group_id":10,"block_polygon_points":[[814.0,725.0],[1116.0,725.0],[1116.0,1122.0],[814.0,1122.0]]},{"block_label":"vertical_text","block_content":"霞に気がついた男は風を切るようにすばやく部屋を飛び出した。霞は追いかけたが、里の外れあたりでこちらを振り向き、不気味な笑いとともに持っていた短刀で己の命を絶った。","block_bbox":[505,728,806,1119],"block_id":11,"block_order":10,"group_id":11,"block_polygon_points":[[505.0,728.0],[806.0,728.0],[806.0,1119.0],[505.0,1119.0]]},{"block_label":"vertical_text","block_content":"その夜、霞は誰にも告げぬまま里を出た。それは、里の掟に反する行為だ。けれども旅に出なければならなかった。兄の仇を討っため、そして真実を知るために…。","block_bbox":[239,728,496,1124],"block_id":12,"block_order":11,"group_id":12,"block_polygon_points":[[239.0,728.0],[496.0,728.0],[496.0,1124.0],[239.0,1124.0]]},{"block_label":"vertical_text","block_content":"「兄さん、行ってくるよ」霞は抜け忍となり、兄の仇を討つべく、霧の中を急いだ。","block_bbox":[103,731,232,1128],"block_id":13,"block_order":12,"group_id":13,"block_polygon_points":[[103.0,731.0],[232.0,731.0],[232.0,1128.0],[103.0,1128.0]]},{"block_label":"vertical_text","block_content":"足技を器用に繰る\n\n柔軟な動き","block_bbox":[1278,1191,1402,1564],"block_id":14,"block_order":13,"group_id":14,"block_polygon_points":[[1278.0,1191.0],[1402.0,1191.0],[1402.0,1564.0],[1278.0,1564.0]]},{"block_label":"vertical_text","block_content":"カスミは現段階で、一番手を掛けて制作しているのではないか？と思われるほど、他キャラと一線を画した、完成された動きを見せてくれる。中でも、素早く相手に突進していき、つかみ、一瞬の内に肘鉄を入れて反対側に抜けていく技は、キメポーズのカメラ視線と相まって美しい。いかにもくノーといった技だ。他にも、伏せてからの足払いや、フランケンシュタイナーに近い、飛び突き系の技に、足技のみのコンビネーションインスト技を見る限り、足技が豊富である。","block_bbox":[499,1171,1245,1569],"block_id":15,"block_order":14,"group_id":15,"block_polygon_points":[[499.0,1171.0],[1245.0,1171.0],[1245.0,1569.0],[499.0,1569.0]]},{"block_label":"vertical_text","block_content":"また、カスミはデモシーンにも登場して、演武を披露してくれているが、これがまた超カッコイイ！","block_bbox":[325,1172,492,1568],"block_id":16,"block_order":15,"group_id":16,"block_polygon_points":[[325.0,1172.0],[492.0,1172.0],[492.0,1568.0],[325.0,1568.0]]},{"block_label":"vertical_text","block_content":"ちなみに写真でお見せすることはできないが、2Pカラーは淡いブルー。どっちをよしとするかは、君次第だ。","block_bbox":[146,1170,315,1566],"block_id":17,"block_order":16,"group_id":17,"block_polygon_points":[[146.0,1170.0],[315.0,1170.0],[315.0,1566.0],[146.0,1566.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1449_207_2357_2946.jpg\" alt=\"Image\" width=\"36%\" /></div>\n","block_bbox":[1449,207,2357,2946],"block_id":18,"group_id":18,"block_polygon_points":[[1449.0,207.0],[2357.0,207.0],[2357.0,2946.0],[1449.0,2946.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_200_1624_756_2004.jpg\" alt=\"Image\" width=\"22%\" /></div>\n","block_bbox":[200,1624,756,2004],"block_id":19,"group_id":19,"block_polygon_points":[[200.0,1624.0],[756.0,1624.0],[756.0,2004.0],[200.0,2004.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_869_1621_1420_2006.jpg\" alt=\"Image\" width=\"22%\" /></div>\n","block_bbox":[869,1621,1420,2006],"block_id":20,"group_id":20,"block_polygon_points":[[869.0,1621.0],[1420.0,1621.0],[1420.0,2006.0],[869.0,2006.0]]},{"block_label":"vertical_text","block_content":"突進していきこの状態に…。今のところ攻撃技。","block_bbox":[788,1623,855,2004],"block_id":21,"block_order":17,"group_id":21,"block_polygon_points":[[788.0,1623.0],[855.0,1623.0],[855.0,2004.0],[788.0,2004.0]]},{"block_label":"vertical_text","block_content":"決まって抜けたら、このカメラアングルに。渋い！","block_bbox":[121,1615,190,1998],"block_id":22,"block_order":18,"group_id":22,"block_polygon_points":[[121.0,1615.0],[190.0,1615.0],[190.0,1998.0],[121.0,1998.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_29_2069_932_2701.jpg\" alt=\"Image\" width=\"36%\" /></div>\n","block_bbox":[29,2069,932,2701],"block_id":23,"group_id":23,"block_polygon_points":[[29.0,2069.0],[932.0,2069.0],[932.0,2701.0],[29.0,2701.0]]},{"block_label":"doc_title","block_content":"# カス三 プロフィール","block_bbox":[1000,2110,1323,2225],"block_id":24,"block_order":19,"group_id":24,"block_polygon_points":[[1000.0,2110.0],[1323.0,2110.0],[1323.0,2225.0],[1000.0,2225.0]]},{"block_label":"text","block_content":"国籍：日本","block_bbox":[1000,2237,1186,2277],"block_id":25,"block_order":20,"group_id":25,"block_polygon_points":[[1000.0,2237.0],[1186.0,2237.0],[1186.0,2277.0],[1000.0,2277.0]]},{"block_label":"text","block_content":"格闘スタイル：忍術（無幻天神流）","block_bbox":[1000,2280,1276,2362],"block_id":26,"block_order":21,"group_id":26,"block_polygon_points":[[1000.0,2280.0],[1276.0,2280.0],[1276.0,2362.0],[1000.0,2362.0]]},{"block_label":"vision_footnote","block_content":"カスミの勝ちポーズの１つだが、胸を強調しているポーズに見えなくもない。逆に隠そうとするのなら、左腕はもうちょっと上かなあ~。とどうでもいいか？","block_bbox":[97,2711,824,2817],"block_id":27,"group_id":27,"block_polygon_points":[[97.0,2711.0],[824.0,2711.0],[824.0,2817.0],[97.0,2817.0]]},{"block_label":"text","block_content":"☑誕生：2月23日（17歳）","block_bbox":[1000,2368,1342,2410],"block_id":28,"block_order":22,"group_id":28,"block_polygon_points":[[1000.0,2368.0],[1342.0,2368.0],[1342.0,2410.0],[1
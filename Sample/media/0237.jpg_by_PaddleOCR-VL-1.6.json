[{"prunedResult":{"model_settings":{"use_doc_preprocessor":false,"use_layout_detection":true,"use_chart_recognition":false,"use_seal_recognition":true,"use_ocr_for_image_block":false,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1_0_2464_178.jpg\" alt=\"Image\" width=\"99%\" /></div>\n","block_bbox":[1,0,2464,178],"block_id":0,"group_id":0,"block_polygon_points":[[1.0,-1.0],[2465.0,-1.0],[2465.0,178.0],[1.0,178.0]]},{"block_label":"doc_title","block_content":"# 新作スクランブル！","block_bbox":[141,91,839,175],"block_id":1,"block_order":1,"group_id":1,"block_polygon_points":[[141.0,91.0],[839.0,91.0],[839.0,175.0],[141.0,175.0]]},{"block_label":"doc_title","block_content":"# ゲームクリエイターになりたい人必見! DEAD OR ALIVE 開発者に聞く 「カスミ」というキャラができるまで。","block_bbox":[1393,293,2336,645],"block_id":2,"block_order":2,"group_id":2,"block_polygon_points":[[1393.0,293.0],[2336.0,293.0],[2336.0,645.0],[1393.0,645.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_150_296_1321_1545.jpg\" alt=\"Image\" width=\"47%\" /></div>\n","block_bbox":[150,296,1321,1545],"block_id":3,"group_id":3,"block_polygon_points":[[150.0,296.0],[1321.0,296.0],[1321.0,1545.0],[150.0,1545.0]]},{"block_label":"vertical_text","block_content":"カスミがどんな感じのキャラかということを、少しは理解してもらったら、次は開発時、デザイン時の苦労話や思い入れを、技術面な面を含めて開発者に存分に語ってもらおう。","block_bbox":[2050,721,2352,1114],"block_id":4,"block_order":3,"group_id":4,"block_polygon_points":[[2050.0,721.0],[2352.0,721.0],[2352.0,1114.0],[2050.0,1114.0]]},{"block_label":"vertical_text","block_content":"今の内からカスミを使おうと、早くも心に決めている読者にとっては、間違いなく興味深い内容のものとなっているはずだ。","block_bbox":[1826,724,2041,1117],"block_id":5,"block_order":4,"group_id":5,"block_polygon_points":[[1826.0,724.0],[2041.0,724.0],[2041.0,1117.0],[1826.0,1117.0]]},{"block_label":"vertical_text","block_content":"女の子が主役？くのー？本当にいいの？ってよく聞かれるんですけど、いいんです。全然いいんです。この子が僕らのアイドル「かすみ」ちゃんなのよ～ん。","block_bbox":[1523,725,1780,1115],"block_id":6,"block_order":5,"group_id":6,"block_polygon_points":[[1523.0,725.0],[1780.0,725.0],[1780.0,1115.0],[1523.0,1115.0]]},{"block_label":"vertical_text","block_content":"幕張のＡＯＵショーでは、うちの新人プログラマの大バグのせいで、プルンプルンの","block_bbox":[1388,727,1516,1117],"block_id":7,"block_order":6,"group_id":7,"block_polygon_points":[[1388.0,727.0],[1516.0,727.0],[1516.0,1117.0],[1388.0,1117.0]]},{"block_label":"vertical_text","block_content":"ボインボインという、へんてこりんな胸ゆれをしちゃって、目のやり場に困るうれしい状態だったみたいですけど、かえって注目を集めちゃったんで、かすみちゃんも変な自信をつけちゃったみたいです。あれからというもの、うち","block_bbox":[1388,1171,1737,1564],"block_id":8,"block_order":7,"group_id":8,"block_polygon_points":[[1388.0,1171.0],[1737.0,1171.0],[1737.0,1564.0],[1388.0,1564.0]]},{"block_label":"vertical_text","block_content":"ありきたりのコメントを1つ…「かけられた方が幸せ？」","block_bbox":[1755,1172,1824,1560],"block_id":9,"block_order":8,"group_id":9,"block_polygon_points":[[1755.0,1172.0],[1824.0,1172.0],[1824.0,1560.0],[1755.0,1560.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1830_1170_2390_1558.jpg\" alt=\"Image\" width=\"22%\" /></div>\n","block_bbox":[1830,1170,2390,1558],"block_id":10,"group_id":10,"block_polygon_points":[[1830.0,1170.0],[2390.0,1170.0],[2390.0,1558.0],[1830.0,1558.0]]},{"block_label":"vertical_text","block_content":"のプログラマたちも、胸がどーしたとか、××がこーしたとか、そーいう仕事しかしてくれないんで、そんなことより、早くモーションのぶっ飛びを直せっつーの。","block_bbox":[2098,1615,2359,2007],"block_id":11,"block_order":9,"group_id":11,"block_polygon_points":[[2098.0,1615.0],[2359.0,1615.0],[2359.0,2007.0],[2098.0,2007.0]]},{"block_label":"vertical_text","block_content":"ところでマジメな話ですがかすみちゃんのアクションは、日光江戸村の忍者関係のＪＡＣさんにやってもらってまして、異色な技が結構あって面白いんです。いわゆるモーションキャプチャーですね。で殺陣（演技指導）の方がこれまた筋金入りの忍者マニアで、頼んでもいないのに絵コンテにないアドリブのアクションを連発。うちのゲームバランスが崩れたら、それは彼の責任でしょう。","block_bbox":[1480,1614,2092,2011],"block_id":12,"block_order":10,"group_id":12,"block_polygon_points":[[1480.0,1614.0],[2092.0,1614.0],[2092.0,2011.0],[1480.0,2011.0]]},{"block_label":"vertical_text","block_content":"冗談はさておき、かすみちゃんの開発は夜な夜な進んでいます。彼女はまだ発展途上で、これからもっともっとかわいい女の子になりますよ。太極拳使いのレイちゃんに負けてられないですからね。それでは、皆さんと遊べる日を楽しみに待ってます。プルンプル～ン!!","block_bbox":[1039,1619,1470,2008],"block_id":13,"block_order":11,"group_id":13,"block_polygon_points":[[1039.0,1619.0],[1470.0,1619.0],[1470.0,2008.0],[1039.0,2008.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_295_1599_888_2011.jpg\" alt=\"Image\" width=\"24%\" /></div>\n","block_bbox":[295,1599,888,2011],"block_id":14,"group_id":14,"block_polygon_points":[[295.0,1599.0],[888.0,1599.0],[888.0,2011.0],[295.0,2011.0]]},{"block_label":"vertical_text","block_content":"テクモ（株）3次元係長","block_bbox":[989,1674,1029,2008],"block_id":15,"block_order":12,"group_id":15,"block_polygon_points":[[989.0,1674.0],[1029.0,1674.0],[1029.0,2008.0],[989.0,2008.0]]},{"block_label":"vertical_text","block_content":"こちらの勝ちポーズは、打って変わって、りりしさ漂う。","block_bbox":[217,1618,287,2002],"block_id":16,"block_order":13,"group_id":16,"block_polygon_points":[[217.0,1618.0],[287.0,1618.0],[287.0,2002.0],[217.0,2002.0]]},{"block_label":"vertical_text","block_content":"胸…バスト…ボイン…。いろんな呼び名がある、この女性を象徴するものに、男は時に憧れ、時には自分を見い出す。そう、人によって多少の深さの違いはあるものの、女性の胸にこだわりを持っていない正常な青年男性など、皆無に近いだろう。","block_bbox":[1848,2059,2240,2449],"block_id":17,"block_order":14,"group_id":17,"block_polygon_points":[[1848.0,2059.0],[2240.0,2059.0],[2240.0,2449.0],[1848.0,2449.0]]},{"block_label":"doc_title","block_content":"# ロープイング格レンクデー","block_bbox":[2291,2060,2355,2751],"block_id":18,"block_order":15,"group_id":18,"block_polygon_points":[[2291.0,2060.0],[2355.0,2060.0],[2355.0,2751.0],[2291.0,2751.0]]},{"block_label":"vertical_text","block_content":"そんな胸をゲームでリアルに表現する1つの手段、それが“3次元モーフィング技術”ぜひ知っておきなさい…。","block_bbox":[1670,2062,1841,2454],"block_id":19,"block_order":16,"group_id":19,"block_polygon_points":[[1670.0,2062.0],[1841.0,2062.0],[1841.0,2454.0],[1670.0,2454.0]]},{"block_label":"vertical_text","block_content":"ーションキャプチャーしているとか、怪しげな噂がまことしやかに流れていますが、残念ながらそれはデマです。","block_bbox":[2071,2504,2242,2892],"block_id":20,"block_order":17,"group_id":20,"block_polygon_points":[[2071.0,2504.0],[2242.0,2504.0],[2242.0,2892.0],[2071.0,2892.0]]},{"block_label":"vertical_text","block_content":"あのＡＯＵショーの後、業界では、テクモが女の子のおっぱいにセンサーをつけてモ","block_bbox":[1493,2064,1622,2452],"block_id":21,"block_order":18,"group_id":21,"block_polygon_points":[[1493.0,2064.0],[1622.0,2064.0],[1622.0,2452.0],[1493.0,2452.0]]},{"block_label":"vertical_text","block_content":"モーフィングってのは、物体を変形させる技術なんですが、うちでは女の子にばっか使ってますね。アクション中の腕や腰の動きから胸の形がどう変形するかをリアルタイムに計算する訳です。胸の柔らかさとか、弾力とかもシミュレートしてます。当然、かすみの17歳の胸と、レイの19歳の胸では揺れ方が違うわけで、そのへんはスタッフ全員、毎日研究を重ねてます。","block_bbox":[1497,2503,2067,2897],"block_id":22,"block_order":19,"group_id":22,"block_polygon_points":[[1497.0,2503.0],[2067.0,2503.0],[2067.0,2897.0],[1497.0,2897.0]]},{"block_label":"doc_title","block_content":"# 次回予告","block_bbox":[178,2090,424,2157],"block_id":23,"block_order":20,"group_id":23,"block_polygon_points":[[178.0,2090.0],[424.0,2090.0],[424.0,2157.0],[178.0,2157.0]]},{"block_label":"vertical_text","block_content":"ジャン・リー（ジークンドー）レイ・ファン（ジークンドー）","block_bbox":[176,2173,388,2337],"block_id":24,"block_order":21,"group_id":24,"block_polygon_points":[[176.0,2173.0],[388.0,2173.0],[388.0,2337.0],[176.0,2337.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_769_2094_1467_2714.jpg\" alt=\"Image\" width=\"28%\" /></div>\n","block_bbox":[769,2094,1467,2714],"block_id":25,"group_id":25,"block_polygon_points":[[769.0,2094.0],[1467.0,2094.0],[1467.0,2714.0],[769.0,2714.0]]},{"block_label":"vision_footnote","block_content":"次号のキャラ紹介第２弾は、この2人。","block_bbox":[176,2366,654,2450],"block_id":26,"group_id":26,"block_polygon_points":[[176.0,2366.0],[654.0,2366.0],[654.0,2450.0],[176.0,2450.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_166_2518_656_2927.jpg\" alt=\"Image\" width=\"19%\" /></div>\n","block_bbox":[166,2518,656,2927],"block_id":27,"group_id":27,"block_polygon_points":[[166.0,2518.0],[656.0,2518.0],[656.0,2927.0],[166.0,2927.0]]},{"block_label":"vision_footnote","block_content":"いやあ～、この動きを伝えられないのが非常に残念。しかもゲーセンじゃ、こんな角度は絶対に見えないぞ。","block_bbox":[767,2721,1442,2790],"block_id":28,"group_id":28,"block_polygon_points":[[767.0,2721.0],[1442.0,2721.0],[1442.0,2790.0],[767.0,2790.0]]},{"block_label":"number","block_content":"229","block_bbox":[106,2963,169,3003],"block_id":29,"group_id":29,"block_polygon_points":[[106.0,2963.0],[169.0,2963.0],[169.0,3003.0],[106.0,3003.0]]}],"layout_det_res":{"boxes":[{"cls_id":14,"label":"image","score":0.3233877122402191,"coordinate":[1,0,2464,178],"polygon_points":[[1.0,-1.0],[2465.0,-1.0],[2465.0,178.0],[1.0,178.0]]},{"cls_id":6,"label":"doc_title","score":0.36299994587898254,"coordinate":[141,91,839,175],"order":1,"polygon_points":[[141.0,91.0],[839.0,91.0],[839.0,175.0],[141.0,175.0]]},{"cls_id":6,"label":"doc_title","score":0.4324794411659241,"coordinate":[1393,293,2336,645],"order":2,"polygon_points":[[1393.0,293.0],[2336.0,293.0],[2336.0,645.0],[1393.0,645.0]]},{"cls_id":14,"label":"image","score":0.9117783308029175,"coordinate":[150,296,1321,1545],"polygon_points":[[150.0,296.0],[1321.0,296.0],[1321.0,1545.0],[150.0,1545.0]]},{"cls_id":23,"label":"vertical_text","score":0.9369792938232422,"coordinate":[2050,721,2352,1114],"order":3,"polygon_points":[[2050.0,721.0],[2352.0,721.0],[2352.0,1114.0],[2050.0,1114.0]]},{"cls_id":23,"label":"vertical_text","score":0.9179933071136475,"coordinate":[1826,724,2041,1117],"order":4,"polygon_points":[[1826.0,724.0],[2041.0,724.0],[2041.0,1117.0],[1826.0,1117.0]]},{"cls_id":23,"label":"vertical_text","score":0.9263176918029785,"coordinate":[1523,725,1780,111
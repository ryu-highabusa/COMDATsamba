],[654.0,2366.0],[654.0,2450.0],[176.0,2450.0]]},{"cls_id":14,"label":"image","score":0.8336625099182129,"coordinate":[166,2518,656,2927],"polygon_points":[[166.0,2518.0],[656.0,2518.0],[656.0,2927.0],[166.0,2927.0]]},{"cls_id":24,"label":"vision_footnote","score":0.8237912058830261,"coordinate":[767,2721,1442,2790],"polygon_points":[[767.0,2721.0],[1442.0,2721.0],[1442.0,2790.0],[767.0,2790.0]]},{"cls_id":16,"label":"number","score":0.7227262854576111,"coordinate":[106,2963,169,3003],"order":23,"polygon_points":[[106.0,2963.0],[169.0,2963.0],[169.0,3003.0],[106.0,3003.0]]}]}},"markdown":{"text":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1_0_2464_178.jpg\" alt=\"Image\" width=\"99%\" /></div>\n\n\n# 新作スクランブル！\n\n# ゲームクリエイターになりたい人必見! DEAD OR ALIVE 開発者に聞く 「カスミ」というキャラができるまで。\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_150_296_1321_1545.jpg\" alt=\"Image\" width=\"47%\" /></div>\n\n\nカスミがどんな感じのキャラかということを、少しは理解してもらったら、次は開発時、デザイン時の苦労話や思い入れを、技術面な面を含めて開発者に存分に語ってもらおう。\n\n今の内からカスミを使おうと、早くも心に決めている読者にとっては、間違いなく興味深い内容のものとなっているはずだ。\n\n女の子が主役？くのー？本当にいいの？ってよく聞かれるんですけど、いいんです。全然いいんです。この子が僕らのアイドル「かすみ」ちゃんなのよ～ん。\n\n幕張のＡＯＵショーでは、うちの新人プログラマの大バグのせいで、プルンプルンの\n\nボインボインという、へんてこりんな胸ゆれをしちゃって、目のやり場に困るうれしい状態だったみたいですけど、かえって注目を集めちゃったんで、かすみちゃんも変な自信をつけちゃったみたいです。あれからというもの、うち\n\nありきたりのコメントを1つ…「かけられた方が幸せ？」\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1830_1170_2390_1558.jpg\" alt=\"Image\" width=\"22%\" /></div>\n\n\nのプログラマたちも、胸がどーしたとか、××がこーしたとか、そーいう仕事しかしてくれないんで、そんなことより、早くモーションのぶっ飛びを直せっつーの。\n\nところでマジメな話ですがかすみちゃんのアクションは、日光江戸村の忍者関係のＪＡＣさんにやってもらってまして、異色な技が結構あって面白いんです。いわゆるモーションキャプチャーですね。で殺陣（演技指導）の方がこれまた筋金入りの忍者マニアで、頼んでもいないのに絵コンテにないアドリブのアクションを連発。うちのゲームバランスが崩れたら、それは彼の責任でしょう。\n\n冗談はさておき、かすみちゃんの開発は夜な夜な進んでいます。彼女はまだ発展途上で、これからもっともっとかわいい女の子になりますよ。太極拳使いのレイちゃんに負けてられないですからね。それでは、皆さんと遊べる日を楽しみに待ってます。プルンプル～ン!!\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_295_1599_888_2011.jpg\" alt=\"Image\" width=\"24%\" /></div>\n\n\nテクモ（株）3次元係長\n\nこちらの勝ちポーズは、打って変わって、りりしさ漂う。\n\n胸…バスト…ボイン…。いろんな呼び名がある、この女性を象徴するものに、男は時に憧れ、時には自分を見い出す。そう、人によって多少の深さの違いはあるものの、女性の胸にこだわりを持っていない正常な青年男性など、皆無に近いだろう。\n\n# ロープイング格レンクデー\n\nそんな胸をゲームでリアルに表現する1つの手段、それが“3次元モーフィング技術”ぜひ知っておきなさい…。\n\nーションキャプチャーしているとか、怪しげな噂がまことしやかに流れていますが、残念ながらそれはデマです。\n\nあのＡＯＵショーの後、業界では、テクモが女の子のおっぱいにセンサーをつけてモ\n\nモーフィングってのは、物体を変形させる技術なんですが、うちでは女の子にばっか使ってますね。アクション中の腕や腰の動きから胸の形がどう変形するかをリアルタイムに計算する訳です。胸の柔らかさとか、弾力とかもシミュレートしてます。当然、かすみの17歳の胸と、レイの19歳の胸では揺れ方が違うわけで、そのへんはスタッフ全員、毎日研究を重ねてます。\n\n# 次回予告\n\nジャン・リー（ジークンドー）レイ・ファン（ジークンドー）\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_769_2094_1467_2714.jpg\" alt=\"Image\" width=\"28%\" /></div>\n\n\n次号のキャラ紹介第２弾は、この2人。\n\n<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_166_2518_656_2927.jpg\" alt=\"Image\" width=\"19%\" /></div>\n\n\nいやあ～、この動きを伝えられないのが非常に残念。しかもゲーセンじゃ、こんな角度は絶対に見えないぞ。","images":{"imgs/img_in_image_box_1_0_2464_178.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//d955ecd4-521b-4667-a33b-766af2a8b9c6/markdown_0/imgs/img_in_image_box_1_0_2464_178.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-06-30T00%3A08%3A12Z%2F-1%2F%2F6a462af6aa80c5df7167d668b5ceb071035d84318577d2bf2a534929aa5907b4","imgs/img_in_image_box_150_296_1321_1545.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//d955ecd4-521b-4667-a33b-766af2a8b9c6/markdown_0/imgs/img_in_image_box_150_296_1321_1545.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-06-30T00%3A08%3A12Z%2F-1%2F%2F710b83220e1065657f6b870d088f8f2cb96f818fc661a382925768fab7c4759e","imgs/img_in_image_box_1830_1170_2390_1558.jpg":"https://pplines-online.bj.bcebos.com/deploy/official/paddleocr/pp-ocr-vl-16-online//d955ecd4-521b-4667-a33b-766af2a8b9c6/markdown_0/imgs/img_in_image_box_1830_1170_2390_1558.jpg?authorization=bce-auth-v1%2FALTAKDN8mY5KlNI7zaRpLmOqrw%2F2026-06-30T00%3A08%3A12Z%2F-1%2F%2F960833d83b161cb1c398019553cc817ed
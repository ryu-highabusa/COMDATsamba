[{"prunedResult":{"model_settings":{"use_doc_preprocessor":false,"use_layout_detection":true,"use_chart_recognition":false,"use_seal_recognition":true,"use_ocr_for_image_block":false,"format_block_content":true,"merge_layout_blocks":true,"markdown_ignore_labels":["number","footnote","header","header_image","footer","footer_image","aside_text"],"return_layout_polygon_points":true},"parsing_res_list":[{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_0_0_2452_1100.jpg\" alt=\"Image\" width=\"100%\" /></div>\n","block_bbox":[0,0,2452,1100],"block_id":0,"group_id":0,"block_polygon_points":[[0.0,-6.0],[2452.0,-6.0],[2452.0,1100.0],[0.0,1100.0]]},{"block_label":"doc_title","block_content":"# キャラ公開の第１弾は“カスミ”。そして、その胸の揺れをリアルなものにした、モーフィング技術の詳細をお届けする。担当：アディ “スマイル” トシ","block_bbox":[796,905,1652,1095],"block_id":1,"block_order":1,"group_id":1,"block_polygon_points":[[796.0,905.0],[1652.0,905.0],[1652.0,1095.0],[796.0,1095.0]]},{"block_label":"vertical_text","block_content":"え～最近ですね、ハイコンプリートモデルの再版に心ときめかし、買いまくっちゃおとか思ってるわけですが…え俺の近況報告はいい？そ、肝心なのは、この“デ","block_bbox":[1240,1180,1499,1569],"block_id":2,"block_order":2,"group_id":2,"block_polygon_points":[[1240.0,1180.0],[1499.0,1180.0],[1499.0,1569.0],[1240.0,1569.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_134_1185_1177_1930.jpg\" alt=\"Image\" width=\"42%\" /></div>\n","block_bbox":[134,1185,1177,1930],"block_id":3,"group_id":3,"block_polygon_points":[[134.0,1185.0],[1177.0,1185.0],[1177.0,1930.0],[134.0,1930.0]]},{"block_label":"vision_footnote","block_content":"ジャン・リーは最も多くモーションキャプチャーが使用されていて、動きが超リアル。","block_bbox":[131,1933,1168,1967],"block_id":4,"group_id":4,"block_polygon_points":[[131.0,1933.0],[1168.0,1933.0],[1168.0,1967.0],[131.0,1967.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1554_1180_2331_1559.jpg\" alt=\"Image\" width=\"31%\" /></div>\n","block_bbox":[1554,1180,2331,1559],"block_id":5,"group_id":5,"block_polygon_points":[[1554.0,1180.0],[2331.0,1180.0],[2331.0,1559.0],[1554.0,1559.0]]},{"block_label":"vertical_text","block_content":"ッドオアアライブ”が、どこまで開発が進んでいるか、ちゅーとこだね。","block_bbox":[2215,1618,2342,2007],"block_id":6,"block_order":3,"group_id":6,"block_polygon_points":[[2215.0,1618.0],[2342.0,1618.0],[2342.0,2007.0],[2215.0,2007.0]]},{"block_label":"vertical_text","block_content":"グラフィック面においては、新しいステージやキャラの容姿が、着々と書まれてきている。次のページから載っているステージなんか、超いい感じでしょ？","block_bbox":[1774,1618,2036,2016],"block_id":7,"block_order":4,"group_id":7,"block_polygon_points":[[1774.0,1618.0],[2036.0,1618.0],[2036.0,2016.0],[1774.0,2016.0]]},{"block_label":"vertical_text","block_content":"少しシステムにも触れておくと、H（ホールド・つかみボタン）+Gで通常投げ。ダウン攻撃は、キャラにもよるが⬆⬆⬆で出るジャンプ系の威力の高いものと、ジャンプせずにその場で出る、威力は低いがスキが少ないものの2つが常備。","block_bbox":[1375,1620,1765,2013],"block_id":8,"block_order":5,"group_id":8,"block_polygon_points":[[1375.0,1620.0],[1765.0,1620.0],[1765.0,2013.0],[1375.0,2013.0]]},{"block_label":"vertical_text","block_content":"現段階では、キャラが完全に地面に背を着けない限り、入力は受け付けてくれないよ","block_bbox":[1239,1623,1369,2012],"block_id":9,"block_order":6,"group_id":9,"block_polygon_points":[[1239.0,1623.0],[1369.0,1623.0],[1369.0,2012.0],[1239.0,2012.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_811_2075_1277_2387.jpg\" alt=\"Image\" width=\"19%\" /></div>\n","block_bbox":[811,2075,1277,2387],"block_id":10,"group_id":10,"block_polygon_points":[[811.0,2075.0],[1277.0,2075.0],[1277.0,2387.0],[811.0,2387.0]]},{"block_label":"vision_footnote","block_content":"カスミの足を、これは恐らくジャン・リーガつかみ技をかけている。","block_bbox":[810,2390,1266,2457],"block_id":11,"group_id":11,"block_polygon_points":[[810.0,2390.0],[1266.0,2390.0],[1266.0,2457.0],[810.0,2457.0]]},{"block_label":"vertical_text","block_content":"キャラ人数は、今のところグラフィックが見れるのは6人。ＡＯＵショーまでは5人だったと思うが、1人渋めの老拳法家が増えた。","block_bbox":[488,2073,738,2459],"block_id":12,"block_order":7,"group_id":12,"block_polygon_points":[[488.0,2073.0],[738.0,2073.0],[738.0,2459.0],[488.0,2459.0]]},{"block_label":"vertical_text","block_content":"一応、最大8キャラまでのキャパシティは用意されていので、もしかしたらもう1キャラぐらいは増えるかもしれない。","block_bbox":[270,2074,485,2460],"block_id":13,"block_order":8,"group_id":13,"block_polygon_points":[[270.0,2074.0],[485.0,2074.0],[485.0,2460.0],[270.0,2460.0]]},{"block_label":"vertical_text","block_content":"また、今まで何度となく本誌に登場していたムエタイ使い（名称ケリー）は、大幅な","block_bbox":[135,2077,262,2460],"block_id":14,"block_order":9,"group_id":14,"block_polygon_points":[[135.0,2077.0],[262.0,2077.0],[262.0,2460.0],[135.0,2460.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_1294_2070_2339_2800.jpg\" alt=\"Image\" width=\"42%\" /></div>\n","block_bbox":[1294,2070,2339,2800],"block_id":15,"group_id":15,"block_polygon_points":[[1294.0,2070.0],[2339.0,2070.0],[2339.0,2800.0],[1294.0,2800.0]]},{"block_label":"image","block_content":"<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_810_2513_1279_2821.jpg\" alt=\"Image\" width=\"19%\" /></div>\n","block_bbox":[810,2513,1279,2821],"block_id":16,"group_id":16,"block_polygon_points":[[810.0,2513.0],[1279.0,2513.0],[1279.0,2821.0],[810.0,2821.0]]},{"block_label":"vision_footnote","block_content":"カスミともう一人の女キャラ、レイ・ファン。こっちも結構…でかい。","block_bbox":[812,2830,1268,2897],"block_id":17,"group_id":17,"block_polygon_points":[[812.0,2830.0],[1268.0,2830.0],[1268.0,2897.0],[812.0,2897.0]]},{"block_label":"vertical_text","block_content":"調整を加えられるらしい。前回プレイしたときは、かなり強いという印象を受けたが…。それと、このゲームの最大の特徴゛つかみ゛は、しゃがみ状態でも機能し、下段技にも効力を発揮することが発覚。勝手な先入観かもしれないが、ーボタンで出せ、全キャラが持っている当て身に近い技だと、上・中段技にのみ有効だと思っていたのだが……。次号はグラフィック面を、","block_bbox":[179,2511,756,2911],"block_id":18,"block_order":10,"group_id":18,"block_polygon_points":[[179.0,2511.0],[756.0,2511.0],[756.0,2911.0],[179.0,2911.0]]},{"block_label":"vision_footnote","block_content":"パロスペシャルに似ているカスミの背後投げ。実戦じゃあまり見れないと思うから、今のうちに拝んどけ！","block_
<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="45">
  <CheatEntries>
    <CheatEntry>
      <ID>120</ID>
      <Description>"Resolve baseref (activate after DOA initializes)"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
local signature = '07 90 08 90 95 90 B0 90 B1 90 B2 90 B3 90 9E 90 B4 90 B5 90 B6 90 29 90 B7 90 B8 90 05 90 B9 90'
local hits = AOBScan(signature)

if hits == nil then
  error('DOA work-RAM signature not found. Let the game finish initializing, then enable this entry again.')
end

local hitCount = hits.Count
if hitCount ~= 1 then
  hits.destroy()
  error(string.format('Expected one DOA work-RAM signature, found %d. baseref was not registered.', hitCount))
end

local anchor = tonumber(hits[0], 16)
hits.destroy()

if getAddressSafe('baseref') ~= nil then
  unregisterSymbol('baseref')
end

-- The signature resides at main-CPU logical address 0x564BA0.
-- Therefore project/Ghidra address X is available as baseref+X.
registerSymbol('baseref', anchor - 0x564BA0, true)

[DISABLE]
if getAddressSafe('baseref') ~= nil then
  unregisterSymbol('baseref')
end
{$asm}
</AssemblerScript>
    </CheatEntry>

codeThree:
  xor ax,ax
  mov word ptr [esi+2C],ax
  jmp codeFive

codeFour:
  cmp word ptr [esi+2C],1
  jbe codeFive
  mov word ptr [esi+2C],1

codeFive:
  movzx eax,word ptr [esi+2C]
  xor ecx,ecx
  jmp return

One:

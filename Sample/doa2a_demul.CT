  <UserdefinedSymbols/>
  <LuaScript>-- DOA2A experimental native debug menu hook. Pause emulator before running.
-- In Cheat Engine: Memory View &gt; Tools &gt; Lua Engine; open this file and execute.
-- Install in a loaded HUMAN-CONTROLLED MATCH. Run again to remove.
local cave = 0xC0202CC
local hook = 0xC0D4300
local control = 0xC020398
local payloadHex = ""
local function unhex(s)
  local t = {}
  for x in s:gmatch("%x%x") do t[#t+1] = tonumber(x,16) end
  return t
end
local payload = unhex(payloadHex)
local original = unhex("b05b0d0c")
local redirected = unhex("cc02020c")
local guards = {
  {0xC026DBC,"e62fd62fc62fb62fa62f962f862f224f"},
  {0xC0D5BB0,"45d3e62f436e224f3064e1624c644032"}
}
local function equalAt(a,t,count)
  local ok,v = pcall(readBytes,a,count or #t,true)
  if not ok or type(v) ~= "table" then return false end
  for i=1,(count or #t) do if v[i] ~= t[i] then return false end end
  return true
end
local function at(base,guest) return base+guest-0x0C020000 end
local function valid(base)
  if not base then return false end
  for _,g in ipairs(guards) do
    if not equalAt(at(base,g[1]),unhex(g[2])) then return false end
  end
  return equalAt(at(base,hook),original) or equalAt(at(base,hook),redirected)
end
local answer = inputQuery("DOA2A debug menu","Pause the emulator in a match first. Enter the Windows host address corresponding to guest 0C020000, or leave blank to search:","")
if answer == nil then return end
local base
if answer:match("%S") then
  base = tonumber(answer:gsub("^0[xX]",""),16)
  if not valid(base) then error("Address/version check failed. No writes made.") end
else
  local results = AOBScan("03 C7 2C D1 19 20 2C D1 1B 20 2B 40 09 00 09 00")
  local candidates = {}
  if results then
    for i=0,results.Count-1 do
      local candidate=tonumber(results[i],16)
      -- The initialized menu row-count byte distinguishes live RAM from a file copy.
      local ok,live = pcall(readBytes,at(candidate,0x0C23E499),1,true)
      if valid(candidate) and ok and live and live[1] == 14 then candidates[#candidates+1]=candidate end
    end
    results.destroy()
  end
  for _,a in ipairs(candidates) do print(string.format("DOA2A candidate: %X",a)) end
  if #candidates ~= 1 then
    error("Found "..#candidates.." candidate RAM mappings. No writes made. Use your known live RAM address and run again.")
  end
  base=candidates[1]
end
local ch=at(base,hook)
local cc=at(base,cave)
if equalAt(ch,redirected) then
  if not equalAt(cc,payload,control-cave) then error("Hook code differs from this package; no writes made.") end
  -- Disconnect first. Control bytes/counters may have changed during use.
  writeBytes(ch,original)
  if not equalAt(ch,original) then error("Could not restore hook pointer.") end
  local zeros={};for i=1,#payload do zeros[i]=0 end
  writeBytes(cc,zeros)
  if not equalAt(cc,zeros) then error("Hook disconnected, but cave cleanup failed.") end
  showMessage("DOA2A debug hook removed. Resume the emulator.")
else
  local zeros={};for i=1,#payload do zeros[i]=0 end
  if not equalAt(cc,zeros) then error("Reserved area is not empty. No writes made.") end
  writeBytes(cc,payload)
  if not equalAt(cc,payload) then
    writeBytes(cc,zeros);error("Payload verification failed; hook was not connected.")
  end
  writeBytes(ch,redirected)
  if not equalAt(ch,redirected) then
    writeBytes(ch,original);writeBytes(cc,zeros);error("Hook verification failed; attempted rollback.")
  end
  print(string.format("Guest 0C020000 maps to host %X",base))
  print(string.format("Menu-enable byte host address: %X",at(base,control)))
  showMessage("Installed experimental DOA2A menu hook. Resume, then press and release P1 Start. Match keeps running. Run this script again while paused to remove.")
end


</LuaScript>
</CheatTable>
